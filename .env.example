# Single public origin: Flask serves both React and /api.
PUBLIC_ORIGIN=http://localhost:8000
PORT=8000
HTTPS=0
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Set DATABASE_URL OR the individual POSTGRES_* variables below.
# DATABASE_URL=postgresql+psycopg://houseguide:password@localhost:5432/houseguide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=houseguide
POSTGRES_USER=houseguide
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Google OAuth Web client ID. Public value; never a client secret.
GOOGLE_CLIENT_ID=

# Google Gemini API key. Other Gemini settings have defaults.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_TOKENS=8192
AI_REQUESTS_PER_HOUR=20

# Service identity — supplied by the operator. Complete address/registration.
LEGAL_ENTITY_NAME=Audela de donnees
LEGAL_COUNTRY=France
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
PRIVACY_EMAIL=admin@audeladedonnees.fr
SUPPORT_EMAIL=admin@audeladedonnees.fr
ADMIN_EMAILS=admin@audeladedonnees.fr
PUBLIC_DOMAIN=houseguide.audeladedonnees.fr
PUBLIC_LAUNCH=0

# SMTP transactional messages
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_SSL=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Stripe: recurring EUR 19 annual Price; configure the customer portal.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_REQUIRED=0

# Nearby restaurants
GEOAPIFY_API_KEY=

# Persistent uploads and operations
# UPLOAD_DIR=/data/uploads
# BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
# Generate: python3 -c 'import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
BACKUP_ENCRYPTION_KEY=
# PG_DUMP_BIN=/usr/bin/pg_dump
ALERT_WEBHOOK_URL=
TRUST_PROXY_HOPS=0

# Optional encrypted offsite backups (private S3-compatible bucket)
BACKUP_S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ERASURE_DIR=/data/erasures
